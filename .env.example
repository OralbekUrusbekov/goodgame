# Провайдер: gemini, openai или mock
LLM_PROVIDER=gemini

# Google Gemini (ключ: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_VERSION=v1beta
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_THINKING=on

# Число требований в одном запросе проверки
CHECK_BATCH_SIZE=12

# OpenAI API или OpenAI-совместимый endpoint (Ollama/vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Максимальное ожидание между повторными запросами LLM, секунды
LLM_MAX_RETRY_DELAY=90
LLM_CACHE=on
LLM_FALLBACK=gemini:gemini-2.5-flash
